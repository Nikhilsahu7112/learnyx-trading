{
  "name": "learnyx-trading",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Learnyx Trading \u2014 a free, login-free trading and financial-market education platform (Hinglish).",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "tsc -b && vite build && node scripts/copy-worker-assets.mjs",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "preview": "vite preview --host 0.0.0.0",
    "serve:worker": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --experimental-strip-types scripts/self-test.mjs && node scripts/render-test.mjs && node scripts/interaction-test.mjs",
    "kv:create": "wrangler kv namespace create LEARNYX_KV",
    "test:content": "node --experimental-strip-types scripts/self-test.mjs",
    "test:render": "node scripts/render-test.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "test:interaction": "node scripts/interaction-test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "lightweight-charts": "4.2.3",
    "lucide-react": "0.548.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261124.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.18.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "wrangler": "4.168.0"
  }
}
